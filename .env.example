APP_NAME=SupportBoard
APP_ENV=local
APP_KEY=base64:YOUR_GENERATED_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=supportboard
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000/api

JWT_SECRET=your-jwt-secret-key-change-in-production

FRONTEND_URL=http://localhost:5173

# LLM Configuration (vLLM / OpenAI compatible)
LLM_ENDPOINT=http://localhost:8000/v1
LLM_MODEL=gpt-3.5-turbo
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30
LLM_STREAM=false
LLM_SYSTEM_PROMPT=You are a helpful customer support assistant. Provide concise, accurate, and friendly responses. If you don't know something, suggest contacting a human agent.

# Web Crawler Configuration
CRAWLER_USER_AGENT=Mozilla/5.0 (SupportBot/1.0; +https://supportboard.local/bot)
CRAWLER_MAX_PAGES=50
CRAWLER_MAX_DEPTH=3
CRAWLER_RESPECT_ROBOTS=true
CRAWLER_TIMEOUT=30

# WhatsApp Business API Configuration
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_MESSAGE_TEMPLATE_ID=
WHATSAPP_AUTO_REPLY=Thanks for contacting us! An agent will reply soon.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=supportboard_verify_token
WHATSAPP_VERIFY_TOKEN=supportboard_verify_token
WHATSAPP_DEFAULT_DEPARTMENT_ID=1
